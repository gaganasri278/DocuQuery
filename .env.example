# ==========================================
# DocuQuery AI - Environment Configuration
# ==========================================

# Active LLM Provider: 'gemini', 'openai', 'ollama', or 'local'
# Default is 'gemini' (enter your GEMINI_API_KEY below or in the UI settings)
LLM_PROVIDER=gemini

# Google Gemini Configuration (Default Provider)
# Paste your Gemini API key from https://aistudio.google.com/ below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM Configuration
# Required only if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings & Retrieval Parameters
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_CHUNKS=4
RELEVANCE_DISTANCE_THRESHOLD=0.78

# File Upload Limits
MAX_FILE_SIZE_MB=25

# Server Configuration
DEBUG=false
